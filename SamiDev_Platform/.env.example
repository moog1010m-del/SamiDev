# Production: lock this to your real web game domain(s), comma separated.
SAMIDEV_ALLOWED_ORIGINS=https://game.example.com

# Redis shared match state.
SAMIDEV_REDIS_URL=redis://redis:6379/0

# Durable accounts, balances, inventory, friends, reports and community chat.
SAMIDEV_PLATFORM_STORE=postgres
SAMIDEV_POSTGRES_USER=samidev
SAMIDEV_POSTGRES_DB=samidev
SAMIDEV_POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD
# Required DSN. URL-encode special characters in the password.
SAMIDEV_DATABASE_URL=postgresql://samidev:CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD@postgres:5432/samidev
# Per gateway; three gateways use at most 30 application connections by default.
SAMIDEV_DATABASE_POOL_SIZE=10

# Authoritative GameHost shards. All gateways must use the same set.
SAMIDEV_GAMEHOST_URLS=http://gamehost1:8091,http://gamehost2:8091,http://gamehost3:8091

# REQUIRED in production: replace with a long random value shared only by gateways/GameHosts.
SAMIDEV_GAMEHOST_SERVICE_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional authoritative pool capture; disabled when empty.
# In Docker, set /app/recordings (the persistent private recordings volume).
SAMIDEV_POOL_RECORD_DIR=

# WebSocket protection. Tune using production telemetry.
SAMIDEV_MAX_MSG_RATE=90
SAMIDEV_RATE_BURST=150

# Gateway is behind the bundled nginx reverse proxy in Docker.
SAMIDEV_TRUST_PROXY=1
# Optional approximate country. Keep disabled unless your trusted ingress
# OVERWRITES X-SamiDev-Country from a verified source; never pass client values.
SAMIDEV_TRUST_GEO_HEADERS=0

# Per-IP room-operation limits. Defaults are load-test friendly; lower them for public launch if desired.
SAMIDEV_CREATE_RATE_PER_MINUTE=600
SAMIDEV_JOIN_RATE_PER_MINUTE=1200

# One-time web invite lifetime and per-IP creation limit.
SAMIDEV_INVITE_TTL_SECONDS=600
SAMIDEV_INVITE_RATE_PER_MINUTE=30

# Production requires PostgreSQL durable storage + Redis realtime + explicit origins.
SAMIDEV_PRODUCTION=1

# In-room chat. Last 30 messages are retained only for the room lifetime.
SAMIDEV_CHAT_MAX_CHARS=160
SAMIDEV_CHAT_RATE_MESSAGES=8
SAMIDEV_CHAT_RATE_WINDOW=10

# The bundled nginx publishes plaintext HTTP only to loopback by default. Put TLS/HTTPS (Cloudflare, ALB, Caddy, host nginx, etc.) in front of it.
SAMIDEV_BIND_IP=127.0.0.1
SAMIDEV_HTTP_PORT=8088

# Platform accounts / lobby / friends / admin.
# Keep game auth enabled so direct /index.html access cannot bypass account identity.
SAMIDEV_REQUIRE_GAME_AUTH=1
SAMIDEV_SESSION_TTL_SECONDS=604800
SAMIDEV_GAME_TICKET_TTL_SECONDS=45

# Local auth bootstrap admin only (ignored when Firebase is enabled).
# Use a strong password, then keep this env secret.
SAMIDEV_ADMIN_USERNAME=admin
SAMIDEV_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD

# Community/lobby chat flood protection.
# Per-user + per-room buckets share the same window.
SAMIDEV_COMMUNITY_CHAT_USER_RATE=10
SAMIDEV_COMMUNITY_CHAT_ROOM_RATE=80
SAMIDEV_COMMUNITY_CHAT_RATE_WINDOW=12

# Optional Firebase email/password auth. Keep 0 until configured and tested.
# See docs/FIREBASE_AUTH_AR.md. These project settings are public, not admin keys.
SAMIDEV_FIREBASE_AUTH=0
SAMIDEV_FIREBASE_PROJECT_ID=
SAMIDEV_FIREBASE_API_KEY=
# Public OAuth client IDs for native Google login (never a client secret).
SAMIDEV_GOOGLE_WEB_CLIENT_ID=
SAMIDEV_GOOGLE_IOS_CLIENT_ID=
# Admin credentials: use ADC on the server or a private read-only secret mount.
# Never paste service-account JSON here or include it in the game/mobile assets.

# Optional server-only Firebase UID to bootstrap the first admin; never a username/email.
# Remove after the verified account receives its admin role.
SAMIDEV_FIREBASE_ADMIN_UID=

# Independent deadline for a new table to fill its seats (seconds, 1..3600).
# Heartbeats/chat/reconnects never extend this deadline.
SAMIDEV_ROOM_WAIT_SECONDS=300

# Optional native friend push. Configure Firebase Cloud Messaging + server ADC.
# Leave disabled until Android/iOS apps and delivery credentials are verified.
SAMIDEV_PUSH_ENABLED=0
SAMIDEV_FIREBASE_MESSAGING_SENDER_ID=
SAMIDEV_FIREBASE_ANDROID_APP_ID=
SAMIDEV_FIREBASE_IOS_APP_ID=
# GOOGLE_APPLICATION_CREDENTIALS must point to a private server-only credential file.
# Xsolla coins: 1,000 coins = 1 USD. Secrets belong on the server only.
XSOLLA_ENABLED=0
XSOLLA_SANDBOX=1
XSOLLA_PROJECT_ID=318587
XSOLLA_API_KEY=
XSOLLA_WEBHOOK_SECRET=
XSOLLA_RETURN_URL=
